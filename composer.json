{
    "name": "horde/phpconfigfile",
    "description": "Read and write config files as PHP Code",
    "type": "library",
    "homepage": "https://www.horde.org",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Ralf Lang",
            "email": "ralf.lang@ralf-lang.de",
            "role": "contributor"
        }
    ],
    "time": "2025-06-02",
    "repositories": [],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan": "^2"
    },
    "suggest": {},
    "autoload": {
        "psr-4": {
            "Horde\\PhpConfigFile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\PhpConfigFile\\Test\\": "test/",
            "Horde\\PhpConfigFile\\Test\\Fixtures\\": "test/fixtures/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "0.x-dev"
        }
    }
}